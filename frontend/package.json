{
  "name": "agroapp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "demo:package": "node scripts/package-demo.mjs",
    "demo:verify": "node scripts/package-demo.mjs --verify",
    "test": "vitest run src scripts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@litertjs/core": "2.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
